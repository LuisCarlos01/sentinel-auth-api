# Copie este arquivo para .env (`cp .env.example .env`) se quiser customizar
# valores localmente. O Docker Compose já tem defaults funcionais mesmo sem
# esse passo.

POSTGRES_DB=sentinel_auth
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel

# Chave de assinatura HS256 do Access token. Valor abaixo é só para desenvolvimento local
# (mesma lógica dos defaults de Postgres acima) — nunca reaproveitar em produção; lá a chave
# real vem de um secret de verdade (ex.: GitHub Actions secrets), nunca commitada.
JWT_SIGNING_KEY=dev-only-signing-key-never-use-in-production-1234567890
